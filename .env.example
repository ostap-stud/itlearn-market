# Адреса backend API для локального запуску зі Spring Boot.
# Якщо застосунок запускається без backend API, інтерфейс використає локальні дані браузера.
VITE_API_BASE_URL=http://localhost:8080/api

# auto  - спочатку пробує API, у разі недоступності використовує локальні дані
# api   - працює лише з backend API
# local - працює з локальними даними браузера
VITE_API_MODE=auto

# Measurement ID потоку даних GA4, наприклад G-XXXXXXXXXX
VITE_GA_MEASUREMENT_ID=
